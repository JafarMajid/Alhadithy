---
import '../styles/global.css';
import Sunset from '../components/Sunset.astro';
import ProjectSlide from '../components/ProjectSlide.astro';
import Motion from '../components/Motion.astro';
const year = new Date().getFullYear();
const heroFirstLine = 'A closer look.';
const heroSecondLine = 'A different ';
const heroEmphasis = 'perspective.';
const letterDelay = 42;
const secondLineDelay = heroFirstLine.length * letterDelay + 200;
const subtitleDelay = secondLineDelay + (heroSecondLine.length + heroEmphasis.length - 1) * letterDelay + 1;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#242424" />
  <meta name="description" content="3D design and animation by Jafar Alhadithy. View the Patek Philippe project and get in touch." />
  <link rel="canonical" href="https://alhadithy.com/" />
  <title>Jafar Alhadithy — 3D Design & Motion</title>
</head>
<body id="top">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header"><nav aria-label="Main navigation"><a class="wordmark" href="#top">JAFAR ALHADITHY</a></nav></header>
  <script>
    const header = document.querySelector('.site-header');
    const hero = document.querySelector('.hero');

    if (header && hero) {
      const observer = new IntersectionObserver(([entry]) => {
        header.classList.toggle('past-hero', !entry.isIntersecting && entry.boundingClientRect.bottom <= 0);
      });
      observer.observe(hero);
    }
  </script>
  <main id="main">
    <section class="hero panel" aria-labelledby="intro-title">
      <Sunset />
      <div class="hero-content">
        <h1 id="intro-title" aria-label={`${heroFirstLine} ${heroSecondLine}${heroEmphasis}`}>
          <span aria-hidden="true">{Array.from(heroFirstLine, (letter, index) => <span class="hero-letter" style={`--letter-delay: ${index * letterDelay}ms`}>{letter}</span>)}<br />{Array.from(heroSecondLine, (letter, index) => <span class="hero-letter" style={`--letter-delay: ${secondLineDelay + index * letterDelay}ms`}>{letter}</span>)}<em>{Array.from(heroEmphasis, (letter, index) => <span class="hero-letter" style={`--letter-delay: ${secondLineDelay + (heroSecondLine.length + index) * letterDelay}ms`}>{letter}</span>)}</em></span>
        </h1>
        <p class="hero-description" style={`--hero-subtitle-delay: ${subtitleDelay}ms`}>3D design and animation by Jafar Alhadithy.</p>
      </div>
      <div class="hero-bottom"><a class="text-link" href="#work">View my work <span aria-hidden="true">↓</span></a></div>
    </section>
    <section class="about panel" id="about" aria-labelledby="about-title">
      <div class="about-grid">
        <div class="about-copy" data-motion="reveal">
          <h2 id="about-title">I’m Jafar.</h2>
          <div class="bio">
            <p>I’m a civil engineer and 3D designer.</p>
            <p>A lot of my work comes down to small adjustments. How a surface reflects its surroundings. How light catches an edge. Details that affect whether something feels real, even when you can’t quite explain why.</p>
          </div>
          <a class="text-link" href="mailto:jafar@alhadithy.com">Get in touch <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="portrait" data-motion="media"><img src="/personalphoto.webp" alt="Jafar Alhadithy" width="1080" height="1080" loading="lazy" decoding="async" /></figure>
      </div>
    </section>
    <section class="work-heading" id="work" aria-labelledby="work-title">
      <h2 id="work-title" data-motion="reveal">My work</h2>
    </section>
    <!-- Project palettes are independent. Navy is only for Patek. -->
    <ProjectSlide
      className="project-patek"
      title="Patek Philippe"
      titleId="patek-title"
      category="3D animation"
      detailTitle="World Time Project"
      description="My take on the Patek Philippe World Time, brought to life in 3D."
      filmId="patek-film"
      filmTitle="The film"
      filmTitleId="film-title"
    >
      <Fragment slot="gallery">
        <figure class="watch-hero"><img src="/patek3.webp" alt="Patek Philippe World Time watch with a blue dial and woven strap" width="1920" height="1920" loading="lazy" decoding="async" /></figure>
        <div class="project-note">
          <p>Every detail<br />deserves a<br /><em>closer look.</em></p>
          <a class="text-link" href="#patek-film">Watch the film <span aria-hidden="true">↓</span></a>
        </div>
        <figure><img src="/patek1.webp" alt="Polished globe inside concentric brushed metal rings" width="1920" height="1920" loading="lazy" decoding="async" /></figure>
        <figure><img src="/patek2.webp" alt="Macro view of the blue woven watch strap and white stitching" width="1920" height="1920" loading="lazy" decoding="async" /></figure>
      </Fragment>
      <Fragment slot="film">
        <div class="video-frame">
          <iframe
            title="Patek Philippe World Time — 3D film by Jafar Alhadithy"
            src="https://player.vimeo.com/video/1182310842?h=506cfc9e92&autoplay=0"
            width="640"
            height="360"
            loading="eager"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
            allowfullscreen
          ></iframe>
        </div>
        <a class="film-external text-link" href="https://vimeo.com/1182310842/506cfc9e92" target="_blank" rel="noopener noreferrer">Open on Vimeo <span aria-hidden="true">↗</span></a>
      </Fragment>
    </ProjectSlide>
  </main>
  <footer class="contact" id="contact">
    <h2 class="contact-title" data-motion="reveal">Get in touch.</h2>
    <p class="contact-description">For project enquiries:</p>
    <a class="email" href="mailto:jafar@alhadithy.com">jafar@alhadithy.com <span aria-hidden="true">↗</span></a>
    <div class="footer-bottom"><span>© {year} Jafar Alhadithy</span><a href="#top">Back to top ↑</a></div>
  </footer>
  <Motion />
</body>
</html>
