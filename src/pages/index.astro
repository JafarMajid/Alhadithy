---
import '../styles/global.css';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#242424" />
  <meta name="description" content="3D design and animation by Jafar Alhadithy. View the Patek Philippe project and get in touch." />
  <link rel="canonical" href="https://alhadithy.com/" />
  <title>Jafar Alhadithy — 3D Design & Motion</title>
</head>
<body id="top">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header"><nav aria-label="Main navigation"><a class="wordmark" href="#top">JAFAR ALHADITHY</a></nav></header>
  <main id="main">
    <section class="hero panel" aria-labelledby="intro-title">
      <!-- Empty by design. Add your background image or video here later. -->
      <div class="hero-background" aria-hidden="true"></div>
      <div class="hero-content">
        <h1 id="intro-title">A closer look.<br />A different <em>perspective.</em></h1>
        <p class="hero-description">3D design and animation by Jafar Alhadithy.</p>
      </div>
      <div class="hero-bottom"><a class="text-link" href="#work">View my work <span aria-hidden="true">↓</span></a></div>
    </section>
    <section class="about panel" id="about" aria-labelledby="about-title">
      <div class="about-grid">
        <div class="about-copy">
          <h2 id="about-title">I’m Jafar.</h2>
          <div class="bio">
            <p>I’m a civil engineer and 3D designer.</p>
            <p>A lot of my work comes down to small adjustments. How a surface reflects its surroundings. How light catches an edge. Details that affect whether something feels real, even when you can’t quite explain why.</p>
          </div>
          <a class="text-link" href="mailto:jafar@alhadithy.com">Get in touch <span aria-hidden="true">↗</span></a>
        </div>
        <figure class="portrait"><img src="/personalphoto.webp" alt="Jafar Alhadithy" width="1080" height="1080" loading="lazy" decoding="async" /></figure>
      </div>
    </section>
    <section class="work-heading" id="work" aria-labelledby="work-title">
      <h2 id="work-title">My work</h2>
    </section>
    <!-- Project palettes are independent. Navy is only for Patek. -->
    <article class="project project-patek" aria-labelledby="patek-title">
      <header class="project-heading">
        <div>
          <p class="project-category">3D animation</p>
          <h2 id="patek-title">Patek Philippe</h2>
        </div>
        <div class="project-description">
          <h3>World Time</h3>
          <p>Multiple time zones on one dial, with local time you can adjust as you travel.</p>
        </div>
      </header>
      <div class="project-gallery">
        <figure class="watch-hero"><img src="/patek3.webp" alt="Patek Philippe World Time watch with a blue dial and woven strap" width="1920" height="1920" loading="lazy" decoding="async" /></figure>
        <div class="project-note">
          <p>Every detail<br />deserves a<br /><em>closer look.</em></p>
          <a class="text-link" href="#patek-film">Watch the film <span aria-hidden="true">↓</span></a>
        </div>
        <figure><img src="/patek1.webp" alt="Polished globe inside concentric brushed metal rings" width="1920" height="1920" loading="lazy" decoding="async" /></figure>
        <figure><img src="/patek2.webp" alt="Macro view of the blue woven watch strap and white stitching" width="1920" height="1920" loading="lazy" decoding="async" /></figure>
      </div>
      <section class="film" id="patek-film" aria-labelledby="film-title">
        <div class="film-heading"><h3 id="film-title">The film</h3><span>World Time</span></div>
        <div class="video-frame">
          <iframe
            title="Patek Philippe World Time — 3D film by Jafar Alhadithy"
            src="https://player.vimeo.com/video/1182310842?h=506cfc9e92&autoplay=0"
            width="640"
            height="360"
            loading="eager"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
            allowfullscreen
          ></iframe>
        </div>
        <a class="film-external text-link" href="https://vimeo.com/1182310842/506cfc9e92" target="_blank" rel="noopener noreferrer">Open on Vimeo <span aria-hidden="true">↗</span></a>
      </section>
    </article>
  </main>
  <footer class="contact" id="contact">
    <h2 class="contact-title">Get in touch.</h2>
    <p class="contact-description">For project enquiries:</p>
    <a class="email" href="mailto:jafar@alhadithy.com">jafar@alhadithy.com <span aria-hidden="true">↗</span></a>
    <div class="footer-bottom"><span>© {year} Jafar Alhadithy</span><a href="#top">Back to top ↑</a></div>
  </footer>
</body>
</html>
